# Copy this file to .env and paste your API key after the equals sign.
# .env is local to this machine and excluded from Git. Keep it private.
TABLEFORGE_OPENAI_API_KEY=

# Optional overrides (otherwise the application defaults apply):
# TABLEFORGE_AIDM_MODEL=gpt-4o-mini
# TABLEFORGE_ROUTER_URL=http://10.0.0.22:8001/route
# Optional reasoning effort: low / medium / high / xhigh. Blank omits the parameter.
# TABLEFORGE_REASONING_EFFORT=medium
# Older routers that return no effort can use optional per-tier overrides:
# TABLEFORGE_ROUTER_EFFORT_CHEAP=low
# TABLEFORGE_ROUTER_EFFORT_STANDARD=medium
# TABLEFORGE_ROUTER_EFFORT_HEAVY=xhigh
# TABLEFORGE_IMAGE_MODEL=gpt-image-2.5-flare
# TABLEFORGE_DATA=C:\DnD\TableForgeData
