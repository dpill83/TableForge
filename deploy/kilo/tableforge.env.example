# Installed as /etc/tableforge/tableforge.env, root:tableforge, mode 0640.
# Never put secrets in the production Git checkout.
TABLEFORGE_DATA=/var/lib/tableforge
TABLEFORGE_OPENAI_API_KEY=
# Add your chosen provider configuration here after installation.
# TABLEFORGE_AIDM_MODEL=gpt-4o-mini
# TABLEFORGE_IMAGE_MODEL=gpt-image-2.5-flare
# TABLEFORGE_ROUTER_URL=https://router.example.com/route
